+def _resolve_single_radar_side(ld_cfg: Dict[str, Any]) -> Optional[str]:
+    """
+    Decide whether the radar counter runs in single-radar mode.
+
+    ld2410.mode:
+      "dual"   — always use A/B sequencing (original behaviour).
+      "single" — count on one radar: A if it has a port, else B.
+      "auto"   — (default) single if only one of A/B has a port configured,
+                 or if only one configured port actually exists at startup
+                 (e.g. B is set to /dev/ttyUSB1 but no second adapter is
+                 plugged in).  Otherwise dual.
+
+    Returns "A" or "B" for single mode, or None for dual mode.
+    """
+    if not ld_cfg.get("enabled", False):
+        return None
+    mode = str(ld_cfg.get("mode", "auto") or "auto").strip().lower()
+    if mode == "dual":
+        return None
+
+    ports = {side: str((ld_cfg.get(side, {}) or {}).get("port", "") or "").strip()
+             for side in ("A", "B")}
+    configured = [side for side in ("A", "B") if ports[side]]
+
+    if mode == "single":
+        if not configured:
+            log.warning("Radar mode 'single' but no radar port configured")
+            return None
+        return configured[0]
+
+    # auto
+    if len(configured) == 1:
+        return configured[0]
+    if len(configured) == 2:
+        present = [side for side in configured if os.path.exists(ports[side])]
+        if len(present) == 1:
+            missing = "B" if present[0] == "A" else "A"
+            log.warning("Radar %s port %s not found — falling back to single-radar "
+                        "mode on radar %s (set ld2410.mode to 'dual' to disable, "
+                        "and restart the plugin after plugging in the second radar)",
+                        missing, ports[missing], present[0])
+            return present[0]
+    return None
+
+
 def _record_car(db: SledDB, ha: HAMqtt, friendly: str, label_tow: str, dir_seq: str) -> None:
     snap = db.snapshot()
     ct   = db.increment_counter("car_total")
diff --git a/scripts/sled_ld2410.py b/scripts/sled_ld2410.py
index c340b78..c3bbe83 100644
--- a/scripts/sled_ld2410.py
+++ b/scripts/sled_ld2410.py
@@ -466,14 +466,22 @@ def decode_report_frame(frame: bytes) -> Optional[Ld2410Report]:
     # Skip target status byte
     if j >= len(body):
         return None
-    status = body[j]; j += 1
+    # Bit-7 masking (same CH340/CP2102 corruption handled in the config
+    # parser): status is 0..3, energies are 0..100 and distance high bytes
+    # are <= 0x23 (9000 cm), so bit 7 is never legitimately set on any of
+    # them.  Without this, a single flipped bit pushes energy > 100 and the
+    # whole frame is silently discarded by the range check below.
+    status = body[j] & 0x7F; j += 1
 
-    if j + 9 > len(body):
+    if j + 8 > len(body):
         return None
 
-    move_dist   = _u16le(body, j);     move_energy  = body[j + 2]; j += 3
-    still_dist  = _u16le(body, j);     still_energy = body[j + 2]; j += 3
-    detect_dist = _u16le(body, j);                                  j += 2
+    def _dist(i: int) -> int:
+        return int(body[i]) | ((int(body[i + 1]) & 0x7F) << 8)
+
+    move_dist   = _dist(j);   move_energy  = body[j + 2] & 0x7F; j += 3
+    still_dist  = _dist(j);   still_energy = body[j + 2] & 0x7F; j += 3
+    detect_dist = _dist(j);                                       j += 2
 
     if not (0 <= move_dist <= 9000 and 0 <= still_dist <= 9000
             and 0 <= move_energy <= 100 and 0 <= still_energy <= 100):
