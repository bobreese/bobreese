+def _fetch_co_cfg(api: str) -> dict:
+    """Read a channel-output config through FPP's API rather than parsing the
+    JSON files directly — the files' format isn't a stable contract across FPP
+    releases, the API is."""
+    with urllib.request.urlopen(api, timeout=3) as resp:
         return json.loads(resp.read())
 
 
+def _fetch_co_other_cfg() -> dict:
+    return _fetch_co_cfg(_CO_OTHER_API)
+
+
+def _find_pca9685_output():
+    """Return (api, cfg, output) for the first PCA9685 output, checking co-pwm
+    (FPP 10 cape outputs) before co-other (older standalone PCA9685 config)."""
+    for api in _CO_APIS:
+        try:
+            cfg = _fetch_co_cfg(api)
+        except Exception:
+            continue
+        if not isinstance(cfg, dict):
+            continue
+        for out in cfg.get('channelOutputs', []):
+            if out.get('type') == 'PCA9685':
+                return api, cfg, out
+    return None, None, None
+
