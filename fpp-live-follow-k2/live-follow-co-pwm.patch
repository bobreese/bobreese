+# ── Body-mounted camera tracking ─────────────────────────────────────────────
+
+class BodyCamTrackingMode(LiveTrackingMode):
+    """Tracking for a camera fixed to the torso (or the scene), not the head.
+
+    The head cannot change what the camera sees, so a closed loop on the head
+    would just drive it to its limits.  Instead:
+      * torso (if configured): closed loop — turns until the subject is
+        centred in the frame, at up to servo_torso_speed deg/sec;
+      * head pan/tilt: aims at the subject from its position in the frame,
+        center + head_aim x 2 x (position - 0.5), rate-limited by each
+        servo's speed.  As the torso catches up the subject drifts to the
+        middle of the frame and the head eases back to center.
+    """
+
+    @staticmethod
+    def _toward(cur: float, target: float, speed: float, lo: float, hi: float) -> float:
+        step = max(-speed * _SERVO_DT, min(speed * _SERVO_DT, target - cur))
+        return max(lo, min(hi, cur + step))
+
+    def _step(self, sx: float, sy: float):
+        lt_cfg     = self._cfg.get('live_tracking', {})
+        servo_cfgs = self._cfg.get('servos', {})
+        cam_w      = self._cfg.get('camera', {}).get('width', 640)
+        deadzone   = lt_cfg.get('deadzone_px', 25) / cam_w
+        err_x, err_y = sx - 0.5, sy - 0.5
+
+        torso_cfg = servo_cfgs.get('torso')
+        if torso_cfg and abs(err_x) > deadzone:
+            speed = float(torso_cfg.get('speed_limit', 45))
+            vel   = speed * 2.0 * err_x
+            if torso_cfg.get('invert', False):
+                vel = -vel
+            cur = self._servos.get_angle('torso')
+            self._servos.set_servo('torso', self._toward(
+                cur, cur + vel * _SERVO_DT, speed,
+                torso_cfg.get('min_angle', 0), torso_cfg.get('max_angle', 180)))
+
+        for name, err, aim_key in (('pan', err_x, 'head_aim_pan'),
+                                   ('tilt', err_y, 'head_aim_tilt')):
+            cfg = servo_cfgs.get(name, {})
